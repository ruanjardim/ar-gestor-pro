{
  "name": "ar-gestor-pro",
  "main": "cloudflare-worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["cloudflare-worker.js", "dist/server/**/*.js", "dist/server/**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ar-gestor-pro-prod",
      "database_id": "d3aac459-143d-44dd-879f-82c15dc3e161"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
